---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { articleSchema, organizationSchema } from '@lib/seo';

export const getStaticPaths = (async () => {
  const articles = await getCollection('articulos', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { Content } = await render(article);
const path = `/articulos/${article.id}/`;
const schemaInput = {
  title: article.data.title,
  description: article.data.description,
  path,
  author: article.data.author,
  image: article.data.image,
  ...(article.data.publishDate ? { publishDate: article.data.publishDate } : {}),
  ...(article.data.updatedDate ? { updatedDate: article.data.updatedDate } : {}),
};
---
<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonicalPath={path}
  image={article.data.image}
  bodyClass="article"
  schema={[organizationSchema(), articleSchema(schemaInput)]}
>
  <Content />
</BaseLayout>
